###############################################################################
#  CONTOH KONFIGURASI — Aplikasi Penjualan TC (Next.js)
#
#  Salin menjadi `.env` di folder yang sama, lalu isi nilainya. Berkas `.env`
#  TIDAK ikut ke Git; berkas contoh ini ikut, dan karena itu TIDAK BOLEH
#  memuat satu pun nilai sungguhan.
#
#  Nilai produksi ada di `.env.production` pada akar repo (juga tidak ikut
#  Git), dan yang benar-benar berjalan ada di Environment Variables Vercel.
#
#  Enam variabel di bawah adalah SELURUH yang dibaca aplikasi ini. Berkas
#  `.env.example` di akar repo adalah milik aplikasi Laravel lama yang
#  disimpan sebagai pembanding — jangan dipakai untuk menyiapkan yang ini.
###############################################################################


#------------------------------------------------------------------------------
# DATABASE — dua alamat, dua port, dan keduanya memang diperlukan
#
#   6543  transaction pooler  -> DATABASE_URL, dipakai APLIKASI.
#         Koneksi dipulangkan ke kolam setiap selesai satu transaksi, jadi
#         sanggup melayani banyak salinan fungsi serverless sekaligus.
#
#   5432  session pooler      -> DIRECT_DATABASE_URL, dipakai perintah Prisma
#         (`prisma db pull`, `prisma generate`) dan skrip di scripts/.
#         Jatahnya hanya 15 koneksi, jadi jangan dipakai aplikasi: produksi
#         pernah tumbang dengan "(EMAXCONNSESSION) max clients reached".
#
# Dua hal yang wajib diperhatikan saat menyusun URL-nya:
#
#   1. Karakter istimewa dalam kata sandi harus di-escape. Tanda "+" menjadi
#      "%2B" — di dalam URL, "+" berarti spasi, dan kalau disalin apa adanya
#      koneksi gagal dengan "password authentication failed" yang menyesatkan.
#
#   2. Akhiran "&uselibpqcompat=true" wajib ada untuk Prisma. Tanpa itu,
#      driver pg memperlakukan sslmode=require sebagai verify-full lalu
#      menolak sertifikat Supabase dengan "self-signed certificate in
#      certificate chain". Lalu lintas tetap terenkripsi; yang dilewati hanya
#      pemeriksaan penerbit sertifikat. Jangan memakai akhiran ini untuk psql
#      — libpq tidak mengenalnya.
#------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<ref>:<sandi>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"
DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<sandi>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"


#------------------------------------------------------------------------------
# SESI
#
# Kunci penanda tangan cookie sesi. Buat yang acak dan panjang:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Menggantinya setelah aplikasi dipakai akan melempar keluar semua orang yang
# sedang login — bukan kerusakan, tapi jangan dilakukan di jam kerja.
#------------------------------------------------------------------------------
AUTH_SECRET=""


#------------------------------------------------------------------------------
# SUPABASE STORAGE
#
# Dipakai HANYA untuk mengunggah logo dan tanda tangan ke bucket "perusahaan"
# (dibuat oleh scripts/siapkan-penyimpanan.mjs). Database tidak disentuh lewat
# kunci ini — sambungannya lewat DATABASE_URL di atas.
#
# SUPABASE_SECRET_KEY melewati seluruh aturan keamanan baris, jadi ia hanya
# boleh hidup di sisi server. Aplikasi ini sengaja tidak punya satu pun
# variabel NEXT_PUBLIC_, supaya tidak ada rahasia yang bisa tersasar ke
# peramban.
#------------------------------------------------------------------------------
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SECRET_KEY=""
